{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Edit(./.claude/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
